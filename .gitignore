.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Dataset (huge, pulled via git-lfs from the IO-VNBD repo — don't duplicate in this repo's history)
data/IO-VNBD/

# comma2k19 demo split (~227MB, pulled via huggingface_hub — see
# src/data/comma2k19_loader.py's module docstring)
data/comma2k19_demo/

# PPC-Dataset (~155MB, urban Japan driving, GitHub taroz/PPC-Dataset via
# OneDrive) and PVS (~900MB, Kaggle jefmenegazzo/pvs-passive-vehicular-
# sensors-datasets) — both real urban/low-speed candidate datasets pulled
# in to address the IO-VNBD urban-drift gap, kept local like every other
# raw dataset above.
data/PPC/
data/PVS/

# Training logs (real ones, run to run, are large/noisy — keep out of history)
logs/*.log

# osmnx's local HTTP response cache (raw Overpass API JSON) — a convenience
# cache, not something to version. Anchored to repo root (leading /) —
# unanchored "cache/" silently matched backend/app/cache/ too (a real
# source module, not a cache directory) and excluded it from tracking.
/cache/

# Generated plots/large CSVs — but keep checkpoints and small eval-result
# JSON: they're real deliverables now (a trained model + its actual numbers),
# small (<1MB each), and worth having in the repo without needing to retrain.
results/*.png
results/*.csv
!results/.gitkeep

# Local safety backups made by `src.train --resume` before it overwrites
# best.pt / train_history.json — convenience for the person running it, not
# a deliverable worth versioning. Globbed (not just the default filename)
# since a custom --own_recordings_dir/--comma2k19_dir run names its own
# history file, and its _prev backup follows suit.
checkpoints/best_prev.pt
checkpoints/*_prev.pt
results/train_history_prev.json
results/*_prev.json

.DS_Store

# Keynote decks kept locally for the hackathon pitch — not source, not
# meant for the public repo history.
*.key

# Stray nested duplicate directory (same name as repo root) that showed up
# in the working tree — not an intentional part of the project.
/SIH26168-ML/

# Google Smartphone Decimeter Challenge download (zip is ~3.5GB, plus a nested
# venv and the unzipped data) — local only, like every other raw dataset above
DECIMETER/

# Marker files written by the background training wrapper scripts, and the
# automatic backup train.py makes of the previous best checkpoint when resuming
logs/*.DONE
checkpoints/*_prev.pt
