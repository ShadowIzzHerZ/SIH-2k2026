<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Exposes only DevRecorder's own recordings/ subfolder, not the
         app's whole external-files area. -->
    <external-files-path name="recordings" path="recordings/" />
    <!-- Internal-storage fallback DevRecorder uses when external storage
         is unavailable. -->
    <files-path name="recordings_internal" path="recordings/" />
</paths>
