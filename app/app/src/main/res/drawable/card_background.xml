<?xml version="1.0" encoding="utf-8"?>
<!-- Zen Civic card: pure white surface, 20dp corners, a hairline border —
     replaces the earlier translucent "glass" look (see DESIGN.md's Cards
     & Grid Panels section). Depth comes from the layout's own elevation
     (soft ambient shadow), not from the fill itself. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="@color/outline" />
</shape>
