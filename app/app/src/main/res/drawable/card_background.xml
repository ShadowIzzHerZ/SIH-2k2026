<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass card look: translucent white pane (map visible through
     it) with a soft vertical gradient and a light border to read as an
     actual pane of glass, not just a flat semi-transparent rectangle.
     True backdrop blur (RenderEffect) needs API 31+ and would need a
     per-device fallback anyway — this reads as "glassy" on every
     supported device (minSdk 26) with no version-gating needed. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#C8FFFFFF"
        android:centerColor="#B3FFFFFF"
        android:endColor="#A6FFFFFF" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#A0FFFFFF" />
</shape>
