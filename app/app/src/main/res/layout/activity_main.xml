<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff">

    <!-- Full-bleed real map — see RoadMapView.kt (osmdroid + OSM tiles,
         same free-tile approach as the Zen/DevStorm-2026 project's
         Leaflet map, ported to native Android). -->
    <com.sih26168.deadreckoning.RoadMapView
        android:id="@+id/roadMapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Floating status card over the map, app-like rather than pushing
         the map down. -->
    <LinearLayout
        android:id="@+id/statusCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="14dp"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#1a202c"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/modeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/status_calibrating"
                android:textColor="#1a202c"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/detailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#4a5568"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/calibrationProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="false"
            android:max="100"
            android:progressTint="#2563eb" />

        <!-- Legend — appears once calibration finishes and the map starts
             drawing, so a judge glancing at the screen doesn't need it
             explained out loud. -->
        <LinearLayout
            android:id="@+id/legendRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout style="@style/LegendItem">
                <View android:layout_width="9dp" android:layout_height="9dp" android:background="@drawable/legend_dot_gnss" />
                <TextView style="@style/LegendLabel" android:text="@string/legend_gnss" />
            </LinearLayout>

            <LinearLayout style="@style/LegendItem">
                <View android:layout_width="9dp" android:layout_height="9dp" android:background="@drawable/legend_dot_blackout" />
                <TextView style="@style/LegendLabel" android:text="@string/legend_blackout" />
            </LinearLayout>

            <LinearLayout style="@style/LegendItem">
                <View android:layout_width="9dp" android:layout_height="9dp" android:background="@drawable/legend_dot_blend" />
                <TextView style="@style/LegendLabel" android:text="@string/legend_blend" />
            </LinearLayout>

            <LinearLayout style="@style/LegendItem">
                <View android:layout_width="9dp" android:layout_height="9dp" android:background="@drawable/legend_dot_matched" />
                <TextView style="@style/LegendLabel" android:text="@string/legend_matched" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Floating toggle card over the map, bottom-anchored. -->
    <LinearLayout
        android:id="@+id/controlsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="6dp"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/replayToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/replay_real_drive"
            android:textColor="#1a202c"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/blackoutToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:text="@string/simulate_blackout"
            android:textColor="#1a202c"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Recenter — a real map you can pan away from needs a way back,
         same idea as Zen's mapView.js recenter button. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/recenterButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/recenter"
        app:srcCompat="@drawable/ic_recenter"
        app:layout_constraintBottom_toTopOf="@id/controlsCard"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
