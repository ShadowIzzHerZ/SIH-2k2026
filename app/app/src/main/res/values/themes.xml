<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light-only, not DayNight: the app's layout hardcodes a white
         background (activity_main.xml), so letting DayNight switch text
         to light-on-dark colors under system dark mode made titles/labels
         invisible against that white background — confirmed on a real
         device (system dark mode) where the title and mode status text
         were both actually rendering, just in white-on-white. -->
    <style name="Theme.DeadReckoning" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary</item>
        <item name="colorAccent">@color/brand_accent</item>
    </style>

    <!-- Map color legend (status card) — one colored dot + label per
         FusionMode plus the map-matched overlay, so the trail colors
         never need explaining out loud during a demo. -->
    <style name="LegendItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="LegendLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textColor">#4a5568</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>
