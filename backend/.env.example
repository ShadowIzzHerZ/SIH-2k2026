# 10Hz Dead Reckoning Backend Engine - SIH 2026
# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Redis Cache Layer (falls back to high-speed in-memory LRU if Redis is unreachable)
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_LIVE_SEC=3600

# Database Configuration (PostgreSQL / TimescaleDB with SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./sih_trajectories.db
# For production PostgreSQL / TimescaleDB, uncomment below:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sih_db

# Sensor Fusion & Queue Settings (10Hz)
IMU_SAMPLING_RATE_HZ=10.0
BACKLOG_CHUNK_SIZE=20
MAX_QUEUE_SIZE=50000

